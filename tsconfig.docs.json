{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.docs.tsbuildinfo",
		"target": "esnext",
		"lib": ["es2023", "dom", "dom.iterable"],
		"moduleDetection": "force",
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["vite/client"],
		"strict": true,
		"noUnusedLocals": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": [
		"docs/.vitepress/**/*.ts"
	]
}
